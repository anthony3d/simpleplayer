<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MP3 Цикл-Плеер"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"/>

    <!-- Имя файла -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Файл:"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="5dp"/>

    <TextView
        android:id="@+id/tvFileName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="-"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="#f0f0f0"
        android:padding="10dp"
        android:layout_marginBottom="15dp"/>

    <!-- Блок с тегами -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Теги:"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="5dp"/>

    <LinearLayout
        android:id="@+id/tagsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#f0f0f0"
        android:padding="10dp"
        android:layout_marginBottom="15dp">
        
        <TextView
            android:id="@+id/tvNoTags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Теги отсутствуют"
            android:textSize="14sp"
            android:gravity="center"/>
    </LinearLayout>

    <!-- История треков -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="История (до 5 треков)"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="5dp"/>

    <LinearLayout
        android:id="@+id/historyContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="15dp"/>

    <Button
        android:id="@+id/btnSelect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📁 Выбрать MP3 файл"
        android:textSize="16sp"
        android:layout_marginBottom="10dp"/>

    <EditText
        android:id="@+id/etPause"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Пауза между повторами (секунды)"
        android:inputType="number"
        android:layout_marginBottom="20dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPlay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="▶ Воспроизвести"
            android:layout_marginEnd="10dp"/>

        <Button
            android:id="@+id/btnStop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⏹ Стоп"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Готов"
        android:gravity="center"
        android:layout_marginTop="20dp"
        android:padding="10dp"
        android:background="#f0f0f0"/>
</LinearLayout>
