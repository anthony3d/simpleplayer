<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_horizontal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnSelect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📁 Загрузить MP3"
            android:textSize="14sp"
            android:layout_marginEnd="10dp"/>

        <Spinner
            android:id="@+id/spinnerPause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="80dp"
            android:entries="@array/pause_options"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnPlayStop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="▶ Воспроизвести"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"/>

    <!-- Блок выделения участка -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp"
        android:gravity="center">

        <TextView
            android:id="@+id/tvCurrentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginEnd="10dp"/>

        <Button
            android:id="@+id/btnSetStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔵 Начало"
            android:textSize="12sp"
            android:layout_marginEnd="5dp"/>

        <Button
            android:id="@+id/btnSetEnd"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔴 Конец"
            android:textSize="12sp"
            android:layout_marginEnd="5dp"/>

        <Button
            android:id="@+id/btnClearSelection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🗑 Сброс"
            android:textSize="12sp"/>
    </LinearLayout>

    <!-- Индикатор выделенного участка -->
    <TextView
        android:id="@+id/tvSelectionInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Участок не выделен"
        android:textSize="12sp"
        android:gravity="center"
        android:padding="4dp"
        android:background="#f5f5f5"
        android:layout_marginBottom="8dp"/>

    <!-- Блок с тегами -->
    <LinearLayout
        android:id="@+id/layoutTags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#f5f5f5"
        android:padding="10dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎤 ---"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="2dp"/>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎵 ---"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="2dp"/>

        <TextView
            android:id="@+id/tvAlbum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💿 ---"
            android:textSize="13sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📋 История"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp"/>

    <ListView
        android:id="@+id/lvHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="8dp"
        android:background="#f5f5f5"/>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Готов"
        android:gravity="center"
        android:padding="8dp"
        android:textSize="13sp"
        android:background="#f0f0f0"/>
</LinearLayout>
